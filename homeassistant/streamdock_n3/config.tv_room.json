{
  "brightness": 60,
  "grab_evdev": true,
  "now_playing_log": { "entities": ["media_player.vugitv_4k_vugitv_4k"] },
  "youtube": {
    "screens": {
      "lg": {
        "match": [
          { "entity": "media_player.lg_tv_2", "attr": "source", "in": ["YouTube"] },
          { "entity": "media_player.lg_tv_2", "attr": "app_id", "in": ["youtube.leanback.v4"] }
        ]
      },
      "atv": {
        "match": [
          { "entity": "media_player.vugitv_4k_vugitv_4k", "attr": "app_id", "in": ["com.google.ios.youtube"] }
        ]
      }
    }
  },
  "atv": {
    "remote": "remote.vugitv_4k_vugitv_4k",
    "media_player": "media_player.vugitv_4k_vugitv_4k",
    "scrub": "touch",
    "seek_steps": [10, [30, 2], [90, 3]],
    "touch_steps": [12, [60, 2], [150, 3]],
    "nav_repeats": [1, 2, 3],
    "medium_interval": 0.25,
    "fast_interval": 0.08,
    "nav_delay": 0.05
  },
  "keys": {
    "1": {
      "label": "Night", "color": "#3b3f9e",
      "state_entity": "switch.tv_room_tv_room_night_sound",
      "on": { "label": "Night\\nON", "color": "#3b5bdb" },
      "off": { "label": "Night\\nOFF", "color": "#262626" },
      "unavailable": { "label": "Night\\n?", "color": "#5c3b00" }
    },
    "2": {
      "label": "Speech", "color": "#188452",
      "state_entity": "switch.tv_room_tv_room_speech_enhancement",
      "on": { "label": "Speech\\nON", "color": "#2b8a3e" },
      "off": { "label": "Speech\\nOFF", "color": "#262626" },
      "unavailable": { "label": "Speech\\n?", "color": "#5c3b00" }
    },
    "3": {
      "label": "TV", "color": "#a3302c",
      "state_entity": "media_player.lg_tv_2",
      "on": { "label": "TV\\nON", "color": "#a3302c" },
      "off": { "label": "TV\\nOFF", "color": "#262626" },
      "unavailable": { "label": "TV\\nOFF", "color": "#262626" }
    },
    "4": {
      "label": "ATV", "color": "#4a4a4a",
      "action": "ha-call media_player.select_source '{\"entity_id\":\"media_player.lg_tv_2\",\"source\":\"Apple OTT\"}'",
      "modes": [
        {
          "when": "youtube",
          "label": "Chapter", "icon": "/config/icons/next_chapter.png",
          "action": { "youtube": "next_chapter" }
        }
      ]
    },
    "5": { "label": "Home", "color": "#262626", "icon": "/config/icons/home.png" },
    "6": { "label": "Back", "color": "#262626", "icon": "/config/icons/back.png" }
  },
  "actions": {
    "knob.1.right": "ha-call media_player.volume_up '{\"entity_id\":\"media_player.tv_room_tv_room\"}'",
    "knob.1.left": "ha-call media_player.volume_down '{\"entity_id\":\"media_player.tv_room_tv_room\"}'",
    "knob.1.press": "ha-call script.turn_on '{\"entity_id\":\"script.tv_room_mute_toggle\"}'",

    "knob.3.right": { "atv_knob": { "axis": "horizontal", "direction": 1 } },
    "knob.3.left": { "atv_knob": { "axis": "horizontal", "direction": -1 } },
    "knob.3.press": "ha-call remote.send_command '{\"entity_id\":\"remote.vugitv_4k_vugitv_4k\",\"command\":\"select\"}'",

    "knob.2.right": { "atv_knob": { "axis": "vertical", "direction": 1 } },
    "knob.2.left": { "atv_knob": { "axis": "vertical", "direction": -1 } },
    "knob.2.press":"ha-call remote.send_command '{\"entity_id\":\"remote.vugitv_4k_vugitv_4k\",\"command\":\"select\"}'",

    "button.7.press": "ha-call remote.send_command '{\"entity_id\":\"remote.vugitv_4k_vugitv_4k\",\"command\":\"menu\"}'",
    "button.8.press": "ha-call remote.send_command '{\"entity_id\":\"remote.vugitv_4k_vugitv_4k\",\"command\":\"home\"}'",
    "button.9.press": "ha-call remote.turn_on '{\"entity_id\":\"remote.vugitv_4k_vugitv_4k\"}'; sleep 2; ha-call media_player.turn_on '{\"entity_id\":\"media_player.vugitv_4k_vugitv_4k\"}'",

    "button.1.press": "ha-call switch.toggle '{\"entity_id\":\"switch.tv_room_tv_room_night_sound\"}'",
    "button.2.press": "ha-call switch.toggle '{\"entity_id\":\"switch.tv_room_tv_room_speech_enhancement\"}'",
    "button.3.press": "ha-call script.turn_on '{\"entity_id\":\"script.tv_room_power_toggle\"}'",
    "button.6.press": "ha-call remote.send_command '{\"entity_id\":\"remote.vugitv_4k_vugitv_4k\",\"command\":\"menu\"}'",
    "button.5.press":"ha-call remote.send_command '{\"entity_id\":\"remote.vugitv_4k_vugitv_4k\",\"command\":\"home\"}'",
    "button.4.press": { "key_action": 4 }
  }
}
