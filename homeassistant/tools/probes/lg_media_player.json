{
  "note": "Spec §10 item 5: the LG's own Media Player. Play a USB/DLNA file in the LG Media Player, run this, and say what each button did (CC/SAP popups, scan speeds, back to 1x on PLAY). Note the mediaId in the getForegroundAppInfo reply: a real id (not \"_\") makes the luna alert trick worth a phase-2 test. Nothing here changes a setting; CC is pressed twice.",
  "steps": [
    {"kind": "snapshot", "entities": ["media_player.lg_tv_2"]},
    {"kind": "webos", "entity_id": "media_player.lg_tv_2", "command": "system/getSystemInfo"},
    {"kind": "webos", "entity_id": "media_player.lg_tv_2", "command": "com.webos.media/getForegroundAppInfo"},
    {"kind": "webos", "entity_id": "media_player.lg_tv_2", "command": "settings/getSystemSettings",
     "payload": {"category": "caption", "keys": ["captionEnable"]}},
    {"kind": "webos", "entity_id": "media_player.lg_tv_2", "command": "com.webos.applicationManager/listLaunchPoints"},
    {"kind": "webos", "entity_id": "media_player.lg_tv_2", "command": "com.webos.media/setSubtitleEnable",
     "payload": {"mediaId": "_", "enable": true}},
    {"kind": "ha", "service": "webostv.button", "data": {"entity_id": "media_player.lg_tv_2", "button": "CC"}},
    {"kind": "wait", "s": 4},
    {"kind": "ha", "service": "webostv.button", "data": {"entity_id": "media_player.lg_tv_2", "button": "CC"}},
    {"kind": "wait", "s": 4},
    {"kind": "ha", "service": "webostv.button", "data": {"entity_id": "media_player.lg_tv_2", "button": "SAP"}},
    {"kind": "wait", "s": 4},
    {"kind": "ha", "service": "webostv.button", "data": {"entity_id": "media_player.lg_tv_2", "button": "BACK"}},
    {"kind": "wait", "s": 2},
    {"kind": "ha", "service": "webostv.button", "data": {"entity_id": "media_player.lg_tv_2", "button": "FASTFORWARD"}},
    {"kind": "wait", "s": 3},
    {"kind": "ha", "service": "webostv.button", "data": {"entity_id": "media_player.lg_tv_2", "button": "FASTFORWARD"}},
    {"kind": "wait", "s": 3},
    {"kind": "ha", "service": "webostv.button", "data": {"entity_id": "media_player.lg_tv_2", "button": "FASTFORWARD"}},
    {"kind": "wait", "s": 3},
    {"kind": "ha", "service": "webostv.button", "data": {"entity_id": "media_player.lg_tv_2", "button": "PLAY"}},
    {"kind": "wait", "s": 3},
    {"kind": "ha", "service": "webostv.button", "data": {"entity_id": "media_player.lg_tv_2", "button": "REWIND"}},
    {"kind": "wait", "s": 3},
    {"kind": "ha", "service": "webostv.button", "data": {"entity_id": "media_player.lg_tv_2", "button": "REWIND"}},
    {"kind": "wait", "s": 3},
    {"kind": "ha", "service": "webostv.button", "data": {"entity_id": "media_player.lg_tv_2", "button": "PLAY"}},
    {"kind": "wait", "s": 3},
    {"kind": "webos", "entity_id": "media_player.lg_tv_2", "command": "media.controls/fastForward"},
    {"kind": "wait", "s": 3},
    {"kind": "webos", "entity_id": "media_player.lg_tv_2", "command": "media.controls/play"}
  ]
}
